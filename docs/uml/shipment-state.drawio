        <mxCell id="c27" value="Delivered is stable for normal operation. Its only outgoing edge is an explicit logistics return with a required reason. Returned is terminal. The local application creates a shipment only when a simulated payment is successful." style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#68786d;" vertex="1" parent="1">

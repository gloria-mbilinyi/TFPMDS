        <mxCell id="c42" value="The React/TypeScript interface calls these application boundaries through REST. A package is a responsibility boundary, not necessarily a separate Python directory. All application dependencies point toward shared guards, persistence or provider ports." style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#68786d;" vertex="1" parent="1">
          <mxGeometry x="60" y="1080" width="2030" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c43" value="Infrastructure note: SQLite sessions enable foreign keys and rollback failures. Stock reservations use conditional UPDATE statements. PostgreSQL requires a driver, schema migrations, deployment configuration and integration testing before use; no PostgreSQL deployment is claimed." style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#68786d;" vertex="1" parent="1">
          <mxGeometry x="60" y="1180" width="2030" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>